# Normalize repository text for reproducible cross-platform diffs
* text=auto eol=lf

*.py text eol=lf
*.pyi text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.ipynb text eol=lf

# Source workbooks and rendered artifacts are binary
*.xls binary
*.xlsx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
